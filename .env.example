DATABASE_URL=postgresql+psycopg://promiseguard:promiseguard-local-only@localhost:5432/promiseguard
PROMISEGUARD_ENV=local
AUTO_CREATE_SCHEMA=false
METRICS_ENABLED=true
# RISK_MODEL_PATH=artifacts/models/risk_model.joblib

# Never commit OPENAI_API_KEY. Export it in the shell or provide it as a secret.
OPENAI_ENABLED=auto
OPENAI_MODEL=gpt-5-nano
OPENAI_BUDGET_USD=3.00
OPENAI_PER_RUN_LIMIT_USD=0.001
OPENAI_MAX_OUTPUT_TOKENS=320
OPENAI_TIMEOUT_SECONDS=30
OPENAI_RESERVATION_TTL_SECONDS=600
