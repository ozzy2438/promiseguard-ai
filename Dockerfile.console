FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY apps ./apps
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e ".[ui]"

EXPOSE 8501
CMD ["streamlit", "run", "apps/operations_console/app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true"]
